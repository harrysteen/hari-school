// Generates DEMO login accounts.
//   npx tsx --conditions=react-server scripts/generate-demo-accounts.mts
// Writes:
//   src/data/accounts-demo.ts  — login IDs + scrypt password HASHES only (safe to commit)
//   demo-logins.md             — the plain demo passwords to hand out (git-ignored)
//   .env.local                 — AUTH_SECRET for signing sessions, if not already set (git-ignored)
import { randomBytes, randomInt, scryptSync } from 'node:crypto';
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { CLASS1_DEMO_STUDENTS } from '../src/data/students-demo';

const WORDS = ['mango', 'tiger', 'lotus', 'river', 'kite', 'star', 'peacock', 'banyan', 'parrot', 'sunflower', 'cloud', 'rainbow'];
const studentPassword = () => `${WORDS[randomInt(WORDS.length)]}${randomInt(1000, 10000)}`;
const strongPassword = () => randomBytes(9).toString('base64url');
const hash = (password: string) => {
  const salt = randomBytes(16).toString('hex');
  return `scrypt$${salt}$${scryptSync(password, salt, 32).toString('hex')}`;
};

type Row = { loginId: string; password: string; role: 'student' | 'teacher' | 'admin'; name: string; classId?: string; studentId?: string };

const rows: Row[] = [
  { loginId: 'ADMIN', password: strongPassword(), role: 'admin', name: 'Principal / Admin' },
  { loginId: 'T-CLASS1', password: strongPassword(), role: 'teacher', name: 'Mrs. Padmavathi (Class 1 teacher)', classId: 'class-1' },
  ...CLASS1_DEMO_STUDENTS.map((s) => ({
    loginId: s.admissionNo, password: studentPassword(), role: 'student' as const, name: s.name, classId: 'class-1', studentId: s.id,
  })),
];

const accounts = rows.map(({ password, ...rest }) => ({ ...rest, passwordHash: hash(password) }));
writeFileSync('src/data/accounts-demo.ts', `import 'server-only';
import type { Role } from '@/lib/auth';

// DEMO login accounts — generated by scripts/generate-demo-accounts.mts.
// Only scrypt password hashes are stored here. Plain passwords are in demo-logins.md (git-ignored).
export type Account = { loginId: string; passwordHash: string; role: Role; name: string; classId?: string; studentId?: string };

export const ACCOUNTS: Account[] = ${JSON.stringify(accounts, null, 2)};
`);

writeFileSync('demo-logins.md', `# Demo logins (DO NOT SHARE PUBLICLY — demo data only)

| Role | Login ID | Password | Opens |
|---|---|---|---|
${rows.map((r) => `| ${r.role} | \`${r.loginId}\` | \`${r.password}\` | ${r.role === 'student' ? r.name : r.role === 'teacher' ? 'Class 1 list + all Class 1 dashboards' : 'Everything'} |`).join('\n')}
`);

const env = existsSync('.env.local') ? readFileSync('.env.local', 'utf8') : '';
if (!/^AUTH_SECRET=/m.test(env)) {
  writeFileSync('.env.local', `${env}${env && !env.endsWith('\n') ? '\n' : ''}AUTH_SECRET=${randomBytes(32).toString('hex')}\n`);
  console.log('Added AUTH_SECRET to .env.local');
}
console.log(`Wrote ${accounts.length} accounts.`);
